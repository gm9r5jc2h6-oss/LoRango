{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lorango-sdxl/run-evidence-v2.schema.json",
  "title": "LoRango sealed run evidence",
  "type": "object",
  "required": ["format", "toolkit_version", "files", "files_digest"],
  "properties": {
    "format": {"const": "lorango-run-evidence-v2"},
    "toolkit_version": {"enum": ["1.4.0", "1.4.1"]},
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "files_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
